# Local development defaults; Compose binds exposed ports to localhost.
POSTGRES_PASSWORD=jobs-local
RABBITMQ_PASSWORD=jobs-local
API_PORT=8080
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
JOB_LEASE_SECONDS=15
JOB_HEARTBEAT_MILLIS=2000
JOB_TIMEOUT_SECONDS=30
JOB_MAX_RECOVERIES=3
JOB_MONITOR_THREADS=4
JOB_RECOVERY_DELAY_MS=1000
WORKER_CONCURRENCY=2
